# Launcher scripts must keep the right line endings on every platform:
# cmd.exe needs CRLF in .bat files; bash needs LF in .sh/.command files.
*.bat      text eol=crlf
*.sh       text eol=lf
*.command  text eol=lf

# Generated from the backend; CI regenerates both and fails on a diff.
sdk/typescript/openapi.json                 linguist-generated=true
sdk/typescript/src/generated/**             linguist-generated=true
