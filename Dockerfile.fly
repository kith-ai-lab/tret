# Single-image deployment: frontend built and served by the backend.
# Used by fly.toml; docker-compose keeps its two-container layout.

FROM node:20-alpine AS frontend
WORKDIR /fe
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend .
RUN npm run build

FROM python:3.12-slim
# setpriv, used below to drop root before exec'ing uvicorn, ships inside
# util-linux — a required-priority package already present in this base image,
# so there is nothing to apt-get here. `command -v setpriv` after this RUN is
# what actually guarantees that rather than assuming it.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0 \
    libcairo2 libffi8 shared-mime-info fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && command -v setpriv

# Non-root runtime identity. uvicorn, WeasyPrint, and every pack-method
# subprocess it spawns run as this user — never root — per docs/hardening.md's
# "container/VM with a non-root user" line. A fixed uid/gid (rather than
# `useradd`'s next-free default) keeps ownership stable across image rebuilds.
#
# --home /app, not homeless: setpriv (below) changes uid/gid but does not
# touch environment, so whatever $HOME the entrypoint inherited (/root, from
# the image default) would otherwise leak straight through to this user.
# asyncpg's connector stats $HOME/.postgresql/postgresql.key on every
# connection looking for an optional client cert; as `tret`, stat()ing
# anything under /root is a PermissionError, not a miss, and the app fails to
# boot. HOME must name a directory this user can actually read.
RUN groupadd --gid 10001 tret \
    && useradd --uid 10001 --gid tret --home /app --no-create-home --shell /usr/sbin/nologin tret
ENV HOME=/app

WORKDIR /app
COPY backend/pyproject.toml ./
COPY backend/tret ./tret
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./
RUN pip install --no-cache-dir .

COPY packs /packs
# Reference documentation, served read-only by GET /api/docs/{slug} — the
# methodology dialog reads this directory, so the prose in the product is the
# prose in the repo with no copy in between. tests/test_docs_api.py fails if this
# line is dropped.
COPY docs /app/docs
COPY --from=frontend /fe/dist /app/frontend-dist

# Everything above is baked into the image at build time, so it can be handed
# to the non-root user right here. The Fly volume at /data is a different
# story — nothing is mounted there yet, so its ownership is fixed at boot
# instead (see fly-entrypoint.sh).
RUN chown -R tret:tret /app /packs

COPY fly-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# This image is a real deployment, so it declares itself one: TRET_ENVIRONMENT
# =production turns the shipped dev defaults into hard boot failures rather than
# a quiet insecure install (tret/config.py::enforce_production_safety,
# docs/hardening.md). A container built from this file therefore refuses to start
# until TRET_SECRET_KEY and TRET_ADMIN_PASSWORD are supplied — which is the
# point. fly.toml restates both values so they are visible where deploys are read.
ENV TRET_PACKS_DIR=/packs \
    TRET_STORAGE_DIR=/data/storage \
    TRET_SERVE_FRONTEND_DIR=/app/frontend-dist \
    TRET_ENVIRONMENT=production \
    TRET_COOKIE_SECURE=true

EXPOSE 8000
# entrypoint.sh starts as root — it needs to chown the freshly mounted Fly
# volume — but application code never runs as root: setpriv's last act is an
# execve into uvicorn as `tret`, replacing the entrypoint process rather than
# forking it, so PID 1 for the container's whole useful lifetime is uvicorn
# running as uid 10001 (verified: `docker exec <container> cat /proc/1/status`
# shows `Uid: 10001 ...`, not 0).
ENTRYPOINT ["/entrypoint.sh"]
# Single worker by design: in-process run event bus (docs/architecture.md).
CMD ["uvicorn", "tret.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
