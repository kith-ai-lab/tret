# Single-image deployment: frontend built and served by the backend.
# Used by fly.toml; docker-compose keeps its two-container layout.

FROM node:20-alpine AS frontend
WORKDIR /fe
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend .
RUN npm run build

FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0 \
    libcairo2 libffi8 shared-mime-info fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/pyproject.toml ./
COPY backend/bench ./bench
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./
RUN pip install --no-cache-dir .

COPY packs /packs
# Reference documentation, served read-only by GET /api/docs/{slug} — the
# methodology dialog reads this directory, so the prose in the product is the
# prose in the repo with no copy in between. tests/test_docs_api.py fails if this
# line is dropped.
COPY docs /app/docs
COPY --from=frontend /fe/dist /app/frontend-dist

# This image is a real deployment, so it declares itself one: BENCH_ENVIRONMENT
# =production turns the shipped dev defaults into hard boot failures rather than
# a quiet insecure install (bench/config.py::enforce_production_safety,
# docs/hardening.md). A container built from this file therefore refuses to start
# until BENCH_SECRET_KEY and BENCH_ADMIN_PASSWORD are supplied — which is the
# point. fly.toml restates both values so they are visible where deploys are read.
ENV BENCH_PACKS_DIR=/packs \
    BENCH_STORAGE_DIR=/data/storage \
    BENCH_SERVE_FRONTEND_DIR=/app/frontend-dist \
    BENCH_ENVIRONMENT=production \
    BENCH_COOKIE_SECURE=true

EXPOSE 8000
# Single worker by design: in-process run event bus (docs/architecture.md).
CMD ["uvicorn", "bench.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
