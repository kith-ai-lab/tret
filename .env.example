# tret configuration. Copy to .env — docker compose reads it automatically.
# All configuration is via environment; tret makes no network calls except to
# the LLM providers you configure below (plus an optional OpenRouter model
# catalog fetch). No telemetry, ever.

# ── security ──────────────────────────────────────────────────────────────────
# development (default) | production. In production tret REFUSES TO START if
# the secret key or admin password below are still these shipped defaults, and
# warns loudly if the session cookie is not TLS-only. See docs/hardening.md.
TRET_ENVIRONMENT=development

# Signs sessions and encrypts provider keys stored via the settings UI.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
TRET_SECRET_KEY=dev-secret-change-me

# First-boot admin (created only if no users exist yet)
TRET_ADMIN_EMAIL=admin@example.com
TRET_ADMIN_PASSWORD=tret-admin

# Send the session cookie only over HTTPS. Set true for any real deployment.
# TRET_COOKIE_SECURE=true

# Login rate limit (in-memory sliding window, per process). Counted in two
# buckets: source-peer + email at this limit, and email alone at 5x it, so the
# limit still bites behind a reverse proxy that makes every request share one
# source address. X-Forwarded-For is deliberately not trusted. docs/hardening.md.
# TRET_LOGIN_MAX_ATTEMPTS=10
# TRET_LOGIN_WINDOW_SECONDS=300

# ── schema migrations ─────────────────────────────────────────────────────────
# tret runs `alembic upgrade head` itself at boot. Set this to skip that step —
# for deployments that migrate from a separate job under a role with DDL rights.
# tret then assumes the database is already at head and will fail on the first
# query that needs a missing column, so pair it with your own upgrade step.
# See docs/upgrading.md and docs/hardening.md §8.
# TRET_SKIP_MIGRATIONS=true

# ── single-instance enforcement ────────────────────────────────────────────────
# The run event bus is in-process (docs/architecture.md), so tret must never run
# as more than one live instance. On Postgres, tret takes a session-level
# advisory lock at boot and holds it for the process lifetime; a second process
# retries for TRET_INSTANCE_LOCK_WAIT_SECONDS (default 30, covers a Fly deploy
# handover) before deciding it lost. warn (default) logs and keeps booting;
# strict refuses to boot instead; off skips the check entirely. No-op on
# SQLite. See docs/hardening.md.
# TRET_INSTANCE_LOCK=strict
# TRET_INSTANCE_LOCK_WAIT_SECONDS=30

# ── tenancy ──────────────────────────────────────────────────────────────────
# Multi-tenant SaaS mode. Leave unset (false): every self-hosted deployment has
# one workspace and every user is a member of it, exactly as before. Set only
# by tret_cloud, where OIDC provisioning (a later release) reads it to decide
# whether a new user gets their own personal workspace instead.
# TRET_MULTI_TENANT=true

# Whether every new workspace (self-host boot, a multi-tenant personal
# workspace, a team workspace) gets every pack in TRET_PACKS_DIR installed.
# Leave unset (true): every deployment mode ships the flagship pack(s) by
# default, so a fresh workspace is never an empty shell. Set false to opt out
# entirely, e.g. an operator who wants to hand-curate what ships.
# TRET_SEED_DEFAULT_PACKS=false

# Base URL of the pack marketplace registry (tret-cloud's /api/marketplace)
# that Find/Install proxy through (tret/api/packs.py's /api/packs/registry/*
# endpoints, gated through the egress chokepoint — see that module's own
# note). The RUN path never reads this: it only affects Find/Install/Submit.
#
# OPT-IN. Unset (the default): no marketplace network calls at all — the
# Find tab and update badges degrade to a friendly empty state, and no
# installed-pack slug, search query, or version ever leaves this deployment.
# Set it to turn Find/Install on: Kith's hosted registry
# (https://cloud.tret.kithailab.com/api/marketplace) or a private mirror.
# TRET_PACK_REGISTRY_URL=https://cloud.tret.kithailab.com/api/marketplace

# ── single sign-on (generic OIDC) ───────────────────────────────────────────
# password (default) | oidc | both. Setting this alone does nothing without
# TRET_OIDC_ISSUER below — the OIDC router only mounts once that is set.
# TRET_AUTH_MODE=oidc

# Issuer, client id/secret from your identity provider's app registration
# (Auth0, Okta, Keycloak, Google...). Never an Auth0 SDK — generic OIDC via
# authlib, so any spec-compliant issuer works. Scheme on the issuer is
# optional (both "your-tenant.us.auth0.com" and the full https:// form work).
# TRET_OIDC_ISSUER=your-tenant.us.auth0.com
# TRET_OIDC_CLIENT_ID=
# TRET_OIDC_CLIENT_SECRET=

# The callback URL registered with the IdP. Strongly recommended for any real
# deployment: behind a TLS-terminating proxy tret cannot safely infer this
# from the request (see config.py). e.g.
# https://cloud.tret.kithailab.com/api/auth/oidc/callback
# TRET_OIDC_REDIRECT_URL=

# Where the browser lands after logout. In `oidc` mode, tret builds Auth0's
# own /v2/logout URL automatically if this is left blank; any other IdP must
# set it explicitly (there is no OIDC-standard end-session endpoint).
# TRET_OIDC_LOGOUT_URL=

# Who a fresh OIDC sign-in may create an account for, comma-separated email
# domains ("kithailab.com,example.org"). Empty (the default) means no domain
# restriction of its own — a self-hosted, non-multi-tenant deployment still
# falls back to requiring an invitation in that case (any IdP-authenticated
# stranger used to land straight in the sole workspace); a multi-tenant
# deployment with this left empty keeps open signup, its own IdP having
# already done the vetting.
# TRET_OIDC_ALLOWED_EMAIL_DOMAINS=

# This deployment's own public base URL — used only to build a link that gets
# emailed out (an invite link), never to reach anything. e.g.
# https://cloud.tret.kithailab.com
# TRET_APP_URL=http://localhost:8000

# ── invite email ─────────────────────────────────────────────────────────────
# off (default) | resend | smtp. Every self-hosted deployment ships off — the
# invite API still works with nothing set here: it always returns the invite
# link itself, so copy-link never depends on this.
# TRET_EMAIL_MODE=resend

# Resend (https://resend.com). TRET_EMAIL_FROM must be a verified sending
# domain in your Resend account, e.g. noreply@tret.kithailab.com.
# TRET_RESEND_API_KEY=
# TRET_EMAIL_FROM=

# Self-hosted SMTP relay, used when TRET_EMAIL_MODE=smtp instead. TRET_EMAIL_FROM
# above is the From address either mode sends as.
# TRET_SMTP_HOST=
# TRET_SMTP_PORT=587
# TRET_SMTP_USERNAME=
# TRET_SMTP_PASSWORD=
# TRET_SMTP_TLS=true

# ── extensions ───────────────────────────────────────────────────────────────
# In-process extension modules (tret/engine/extensions.py), comma-separated
# dotted module names. Each module's `register(ext)` is called at boot with the
# shared ExtensionAPI, and may mount its own router, gate runs before they
# start, or hook into a run's finish. Empty (the default) is what every
# open-source deployment ships: the seam is entirely inert.
# TRET_EXTENSIONS=

# ── deterministic method sandbox ──────────────────────────────────────────────
# Run each pack-authored method in an empty network namespace. Requires Linux
# and the `unshare` binary (util-linux) with permission to use it; elsewhere
# tret logs a warning and runs without network isolation. Pack methods are
# operator-trusted code either way — docs/hardening.md explains the limits.
# TRET_METHODS_NETWORK_ISOLATION=true

# ── outbound network: what tret may talk to ───────────────────────────────────
# Egress is four switchable classes rather than one boolean, because "no
# internet" and "no *research* internet" are different deployments. Every setting
# here narrows: the master switch narrows a class, and an admin can narrow again
# at runtime (POST /api/settings/egress) but never widen. docs/hardening.md §9.
#
#   provider   cloud model calls (Anthropic, Kimi, OpenRouter)
#   catalog    the OpenRouter model list, provider key validation
#   local      a self-hosted model server at TRET_LOCAL_BASE_URL
#   research   web search and page fetch
#   search     the web search backend itself (TRET_SEARXNG_BASE_URL or Brave) —
#              no switch of its own, it follows research (see below)
#
# TRET_EGRESS=off is the air-gapped deployment: provider, catalog, research and
# search all go dark (search is severed together with research) and only local
# inference remains — and the local server then has to resolve to a private
# address, so the exemption is checked rather than assumed.
# TRET_EGRESS=on
# TRET_EGRESS_PROVIDER=on
# TRET_EGRESS_CATALOG=on
# TRET_EGRESS_LOCAL=on

# Web search and page fetch. OFF by default, and the default is the point: this
# is the only class whose destination is chosen by a model, from text that may
# have arrived in an uploaded document. `replay` reads only pages a previous run
# already snapshotted and makes no new requests — how a benchmark or an audit
# re-runs offline.
# TRET_EGRESS_RESEARCH=off          # off | replay | on
#
# Hosts research may reach, comma-separated, subdomains included. EMPTY MEANS THE
# PUBLIC WEB: a general web search cannot run against an allowlist, and saying so
# is better than an allowlist that covers everything. Set it and research becomes
# a real allowlist. Your search backend does NOT need to be listed here — it
# rides its own `search` egress class below, not this one.
# TRET_EGRESS_RESEARCH_ALLOW_HOSTS=sec.gov,eur-lex.europa.eu
# TRET_EGRESS_RESEARCH_MAX_BYTES=2000000
# TRET_EGRESS_RESEARCH_TIMEOUT_SECONDS=20.0
# TRET_EGRESS_RESEARCH_MAX_FETCHES_PER_RUN=10
#
# Force every outbound request through one proxy. The allowlist above is enforced
# by code running inside the process it constrains — a deterrent. A proxy the
# workload cannot bypass is the boundary. Use one for anything internet-facing.
# TRET_EGRESS_PROXY=http://egress-proxy.internal:3128

# Web search backend. Empty = none: `web_search` stays registered and tells the
# model it is unconfigured, so a harness that lists it still runs.
#   brave     hosted API; the query leaves your network
#   searxng   your own instance; the query does not
#
# This endpoint rides its own `search` egress class, not `research` — it is
# something YOU named, never a URL a model chose, so it gets `local`'s trust
# rather than `research`'s SSRF checks (docs/hardening.md §9). Concretely: an
# internal SearXNG URL — plain http, an odd port, a private address like
# http://searxng:8080 or http://10.0.4.12:8080 — is fine here and does not need
# to appear in TRET_EGRESS_RESEARCH_ALLOW_HOSTS above. It is still severed
# together with research: `search` has no switch of its own, and turning
# TRET_EGRESS_RESEARCH off (or narrowing it via the settings API) takes this
# down with it. `docker compose --profile search up` bundles a SearXNG instance
# for this — see the `searxng` service in docker-compose.yml.
# TRET_SEARCH_PROVIDER=
# TRET_SEARCH_API_KEY=
# TRET_SEARXNG_BASE_URL=http://searxng.internal:8080

# ── LLM providers (set at least one; OpenRouter alone unlocks the full demo) ──
TRET_ANTHROPIC_API_KEY=
TRET_MOONSHOT_API_KEY=
TRET_OPENROUTER_API_KEY=

# ── model router ──────────────────────────────────────────────────────────────
# The small/fast model that picks the execution model for auto-mode harnesses.
# If this model's provider has no key configured, tret does not skip LLM
# routing: it substitutes the cheapest small (economy-tier or below) model from a
# provider that IS configured, so one OpenRouter key is enough to see real router
# reasoning. The model that actually decided is what gets recorded on the run's
# routing decision, never merely the one named here.
# A harness capped at `max_cost_tier: local` routes with a local model or with
# the deterministic fallback — it never contacts a cloud router. See
# docs/local-models.md.
TRET_ROUTER_MODEL=anthropic/claude-haiku-4-5

# Disable the optional dynamic OpenRouter catalog fetch (static catalog only)
# TRET_OPENROUTER_CATALOG=false

# ── headless CLI (`tret run`) ──────────────────────────────────────────────────
# Where `tret run` appends one JSON receipt line per run. Empty means
# ~/.tret/ledger.jsonl.
# TRET_LEDGER_PATH=

# ── local models (Ollama, LM Studio, vLLM, llama.cpp server) ──────────────────
# Point this at any OpenAI-compat /v1 endpoint to run tret with zero cloud
# provider keys. Setting a base URL is what enables the provider — no API key
# is required (most local servers ignore auth entirely). See docs/local-models.md.
# Never installed one? docs/local-models.md walks through Ollama from zero
# (install, `ollama pull qwen2.5:14b-instruct`, verify) in about ten minutes.
# TRET_LOCAL_BASE_URL=http://localhost:11434/v1   # Ollama; LM Studio is :1234, vLLM :8000
# Running the docker compose stack? Your host's server is not the container's
# localhost — use http://host.docker.internal:11434/v1 instead.
# TRET_LOCAL_API_KEY=
# TRET_LOCAL_DISPLAY_NAME=Local

# Want no manual install at all? compose can bring its own Ollama:
#
#   TRET_LOCAL_BASE_URL=http://ollama:11434/v1     # the compose service, not localhost
#   docker compose --profile local up
#
# That starts an `ollama` service on the compose network and a one-shot
# `ollama-init` that pulls the model below into a persistent volume. Expect a
# multi-GB download on first start, and CPU-only (slow) inference — Docker
# Desktop passes no GPU through on macOS, so a native install is faster on
# Apple Silicon. Keep this .env-driven: without the profile running, an
# unconditional ollama URL would just show local as configured-but-down.
# TRET_LOCAL_PULL_MODEL=qwen2.5:7b-instruct       # what ollama-init pulls

# Probe each discovered local model with a cheap forced-tool-call before
# letting it into router candidacy (many local models advertise tool support
# they don't actually honor). Disable only if you've already verified your
# models' tool calling and want to skip the extra round trip.
# TRET_LOCAL_PROBE_TOOLS=true

# ── ecological / emissions accounting ─────────────────────────────────────────
# Every number below is an ESTIMATE — calibrated against published data where any
# exists, and still an estimate: energy is inferred from token counts and a
# per-model energy class, nothing is metered, and none of it is audit-grade or fit
# for statutory reporting. Each default's source, date and confidence is recorded
# on every run under energy_accounting.factors, so you can see where a number came
# from without reading the code. Read docs/emissions-methodology.md before quoting
# any of it.

# Grams of CO2e per kWh, used to turn each run's estimated energy into an
# estimated carbon figure. The default 470 is the IEA's 2024 global power-sector
# average (Electricity 2025 reports ~460–480; 470 is the midpoint). Set your
# region's or your supplier's number for a less wrong answer — EPA eGRID
# subregions span more than 10x (e.g. ~30 for Sweden, ~350 US average, ~700+ for
# a coal-heavy grid). Regional sources: Electricity Maps (hourly per zone; free
# tier is one zone, non-commercial), WattTime (marginal rates — a different
# question), eGRID/IEA (annual averages, what most frameworks expect). tret
# ships no API integration for these on purpose: a stored run's carbon must not
# depend on a third party's uptime.
# TRET_GRID_CO2E_G_PER_KWH=470

# GHG Protocol Scope 2 basis of the factor above: location_based (the physical
# grid that served the load), market_based (contractual renewable claims — PPAs,
# RECs, GOs), or unspecified. These are NOT interchangeable and must never be
# summed; a market-based figure can be ~3x below the location-based one for the
# same electricity. The label is recorded per run, and a window mixing bases is
# flagged in GET /api/analytics/emissions.
# TRET_GRID_CO2E_BASIS=location_based

# Per-provider / per-deployment grid factors, as JSON keyed by tret provider
# name (local | anthropic | kimi | openrouter). Use this when you know where the
# electricity came from: you self-host in a known place, or you have pinned a
# provider to a region, or a provider published a factor you accept.
#
#   TRET_GRID_FACTORS={"local":{"g_per_kwh":42,"basis":"location_based","label":"Ontario grid, IESO 2024"},"anthropic":{"g_per_kwh":120,"basis":"market_based","label":"provider PPA disclosure"}}
#
# Each entry takes g_per_kwh (a positive number), an optional basis
# (location_based | market_based | unspecified — defaults to unspecified, because
# tret will not guess what your number represents) and an optional short label
# shown next to the factor in the run's provenance table. Any other key inside an
# entry is a hard error; a provider name tret does not recognise only warns at
# startup, so a config that predates a new provider still boots.
#
# Precedence: this map (by provider) → TRET_LOCAL_GRID_CO2E_G_PER_KWH below for
# a self-hosted run → TRET_GRID_CO2E_G_PER_KWH. Every run records WHICH of those
# applied (grid_co2e_source: provider:anthropic | local_setting | global_default)
# so a figure can explain itself later.
#
# This is CONFIGURATION, never inference. tret does not derive a grid region
# from an IP address, and adds no network call to look one up: for a cloud API
# call your own location says nothing about which data centre served the request,
# providers do not disclose the serving region, and OpenRouter routes to whichever
# upstream has capacity. Location is knowable only when you know it.
#
# Mixing bases has a consequence: GET /api/analytics/emissions stops reporting a
# single carbon total for a window that spans location-based and market-based
# figures, and reports subtotals per basis instead. Energy in Wh still sums.
# TRET_GRID_FACTORS=

# LEGACY, still honoured exactly as before: a separate factor for self-hosted
# (local) inference, where you buy the power yourself and may have a site- or
# market-based number (supplier mix, a PPA, on-site solar). Unset, local runs use
# TRET_GRID_CO2E_G_PER_KWH. This is the factor that lands in GHG Protocol
# Scope 2 — say which basis it is. TRET_GRID_FACTORS={"local":{...}} supersedes
# it and can carry a label; prefer that for new configuration.
# TRET_LOCAL_GRID_CO2E_G_PER_KWH=30
# TRET_LOCAL_GRID_CO2E_BASIS=market_based

# Data-centre overhead: PUE = total facility energy / IT-load energy, resolved
# per deployment profile.
#   cloud       1.2   — above every hyperscaler self-report (Google 1.09 in its
#                       2025 Environmental Report, AWS 1.15, Microsoft 1.16
#                       FY2024) and well below the industry average, i.e.
#                       deliberately conservative for a facility tret cannot see.
#   workstation 1.05  — a desktop: fans and a share of room cooling.
#   onprem      1.56  — the Uptime Institute 2024 Global Data Center Survey
#                       average across 879 operators. If you self-host in a real
#                       machine room, use this and not the hyperscaler number:
#                       set TRET_LOCAL_DEPLOYMENT_PROFILE=onprem_datacenter.
# Compute energy is reported separately from the PUE-inclusive total, so the
# overhead is always visible.
# TRET_DATACENTER_PUE=1.2
# TRET_LOCAL_PUE=1.05
# TRET_ONPREM_PUE=1.56
# TRET_LOCAL_DEPLOYMENT_PROFILE=workstation

# Amortized embodied (manufacturing) carbon per local run, in grams — Scope 3
# Cat. 2, capital goods. Default 0 means NOT COUNTED, which understates
# self-hosted inference and makes local models look better than they are. Cited
# constants to compute one (EcoLogits' convention, so your figure is comparable
# with published ones): NVIDIA H100 273 kgCO2eq/unit, server chassis excluding
# GPUs 5,700 kgCO2eq, 3-year lifetime, batch size 64 —
# tret.services.emissions.amortized_embodied_g_per_run does the arithmetic.
# READ THIS FIRST: the 273 kg GPU figure traces to Boavizta, which states it
# could not find real GPU manufacturing LCA data and assumed parity with CPU/RAM,
# and gives 30–50% margin of error on manufacturing footprints generally. It is a
# placeholder resting on a placeholder — better than 0, not good.
# TRET_EMBODIED_G_PER_RUN=0

# Multiplicative uncertainty band around every reported figure: low =
# central/2.5, high = central x 2.5. A JUDGMENT BAND matching field practice —
# Green Algorithms (Lannelongue et al., Advanced Science 2021) claims
# order-of-magnitude correctness only, Boavizta states 30–50%, a 2025 validation
# study found hardware-measuring tools underestimate ground truth by 20–30% while
# spec-based estimation ranges -40% to +40%, and the batch-size assumption alone
# moves published figures by 45%. It is NOT a confidence interval and NOT a
# standard deviation; nothing in this field publishes one. Values below 1 are
# clamped to 1.
# TRET_UNCERTAINTY_BAND_LOW=2.5
# TRET_UNCERTAINTY_BAND_HIGH=2.5

# Model for the frontier-baseline counterfactual reported on each run and in
# GET /api/analytics/emissions. Empty auto-selects the highest-energy-class
# curated non-local model. The comparison re-prices the SAME token counts through
# that model: an efficiency indicator, never an offset, a credit, or a reduction
# claim, and it goes negative when a run is heavier than the baseline.
# TRET_EMISSIONS_BASELINE_MODEL=anthropic/claude-fable-5

# ── local development (outside docker) ────────────────────────────────────────
# TRET_DATABASE_URL=postgresql+asyncpg://tret:tret@localhost:5432/tret
# TRET_STORAGE_DIR=./storage
# TRET_PACKS_DIR=../packs
