# bench configuration. Copy to .env — docker compose reads it automatically.
# All configuration is via environment; bench makes no network calls except to
# the LLM providers you configure below (plus an optional OpenRouter model
# catalog fetch). No telemetry, ever.

# ── security ──────────────────────────────────────────────────────────────────
# Signs sessions and encrypts provider keys stored via the settings UI.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
BENCH_SECRET_KEY=dev-secret-change-me

# First-boot admin (created only if no users exist yet)
BENCH_ADMIN_EMAIL=admin@example.com
BENCH_ADMIN_PASSWORD=bench-admin

# ── LLM providers (set at least one; OpenRouter alone unlocks the full demo) ──
BENCH_ANTHROPIC_API_KEY=
BENCH_MOONSHOT_API_KEY=
BENCH_OPENROUTER_API_KEY=

# ── model router ──────────────────────────────────────────────────────────────
# The small/fast model that picks the execution model for auto-mode harnesses.
BENCH_ROUTER_MODEL=anthropic/claude-haiku-4-5

# Disable the optional dynamic OpenRouter catalog fetch (static catalog only)
# BENCH_OPENROUTER_CATALOG=false

# ── local development (outside docker) ────────────────────────────────────────
# BENCH_DATABASE_URL=postgresql+asyncpg://bench:bench@localhost:5432/bench
# BENCH_STORAGE_DIR=./storage
# BENCH_PACKS_DIR=../packs
