# bench configuration. Copy to .env — docker compose reads it automatically.
# All configuration is via environment; bench makes no network calls except to
# the LLM providers you configure below (plus an optional OpenRouter model
# catalog fetch). No telemetry, ever.

# ── security ──────────────────────────────────────────────────────────────────
# development (default) | production. In production bench REFUSES TO START if
# the secret key or admin password below are still these shipped defaults, and
# warns loudly if the session cookie is not TLS-only. See docs/hardening.md.
BENCH_ENVIRONMENT=development

# Signs sessions and encrypts provider keys stored via the settings UI.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
BENCH_SECRET_KEY=dev-secret-change-me

# First-boot admin (created only if no users exist yet)
BENCH_ADMIN_EMAIL=admin@example.com
BENCH_ADMIN_PASSWORD=bench-admin

# Send the session cookie only over HTTPS. Set true for any real deployment.
# BENCH_COOKIE_SECURE=true

# Login rate limit (in-memory sliding window, per client IP + email).
# BENCH_LOGIN_MAX_ATTEMPTS=10
# BENCH_LOGIN_WINDOW_SECONDS=300

# ── deterministic method sandbox ──────────────────────────────────────────────
# Run each pack-authored method in an empty network namespace. Requires Linux
# and the `unshare` binary (util-linux) with permission to use it; elsewhere
# bench logs a warning and runs without network isolation. Pack methods are
# operator-trusted code either way — docs/hardening.md explains the limits.
# BENCH_METHODS_NETWORK_ISOLATION=true

# ── LLM providers (set at least one; OpenRouter alone unlocks the full demo) ──
BENCH_ANTHROPIC_API_KEY=
BENCH_MOONSHOT_API_KEY=
BENCH_OPENROUTER_API_KEY=

# ── model router ──────────────────────────────────────────────────────────────
# The small/fast model that picks the execution model for auto-mode harnesses.
BENCH_ROUTER_MODEL=anthropic/claude-haiku-4-5

# Disable the optional dynamic OpenRouter catalog fetch (static catalog only)
# BENCH_OPENROUTER_CATALOG=false

# ── local models (Ollama, LM Studio, vLLM, llama.cpp server) ──────────────────
# Point this at any OpenAI-compat /v1 endpoint to run bench with zero cloud
# provider keys. Setting a base URL is what enables the provider — no API key
# is required (most local servers ignore auth entirely). See docs/local-models.md.
# Never installed one? docs/local-models.md walks through Ollama from zero
# (install, `ollama pull qwen2.5:14b-instruct`, verify) in about ten minutes.
# BENCH_LOCAL_BASE_URL=http://localhost:11434/v1   # Ollama; LM Studio is :1234, vLLM :8000
# Running the docker compose stack? Your host's server is not the container's
# localhost — use http://host.docker.internal:11434/v1 instead.
# BENCH_LOCAL_API_KEY=
# BENCH_LOCAL_DISPLAY_NAME=Local

# Want no manual install at all? compose can bring its own Ollama:
#
#   BENCH_LOCAL_BASE_URL=http://ollama:11434/v1     # the compose service, not localhost
#   docker compose --profile local up
#
# That starts an `ollama` service on the compose network and a one-shot
# `ollama-init` that pulls the model below into a persistent volume. Expect a
# multi-GB download on first start, and CPU-only (slow) inference — Docker
# Desktop passes no GPU through on macOS, so a native install is faster on
# Apple Silicon. Keep this .env-driven: without the profile running, an
# unconditional ollama URL would just show local as configured-but-down.
# BENCH_LOCAL_PULL_MODEL=qwen2.5:7b-instruct       # what ollama-init pulls

# Probe each discovered local model with a cheap forced-tool-call before
# letting it into router candidacy (many local models advertise tool support
# they don't actually honor). Disable only if you've already verified your
# models' tool calling and want to skip the extra round trip.
# BENCH_LOCAL_PROBE_TOOLS=true

# ── ecological / emissions accounting ─────────────────────────────────────────
# Every number below is a heuristic, and everything downstream of them is an
# ESTIMATE: energy is inferred from token counts and a per-model energy class,
# nothing is metered, and none of it is audit-grade or fit for statutory
# reporting. Read docs/emissions-methodology.md before quoting any of it.

# Grams of CO2e per kWh, used to turn each run's estimated energy into an
# estimated carbon figure. The default is the rough world-average grid intensity;
# set your region's or your cloud provider's number for a less wrong answer
# (e.g. ~30 for Sweden, ~380 for the US average, ~700 for a coal-heavy grid).
# BENCH_GRID_CO2E_G_PER_KWH=400

# Optional separate factor for self-hosted (local) inference, where you buy the
# power yourself and may have a site- or market-based number (supplier mix, a
# PPA, on-site solar). Unset, local runs use BENCH_GRID_CO2E_G_PER_KWH. This is
# the factor that lands in GHG Protocol Scope 2.
# BENCH_LOCAL_GRID_CO2E_G_PER_KWH=30

# Data-centre overhead: PUE = total facility energy / IT-load energy. Cloud
# hyperscalers self-report fleet-wide PUE around 1.1–1.2; 1.2 is a mildly
# conservative pick inside that band, for a facility bench cannot see. Self-hosted
# inference on a desktop has almost no facility overhead, so local defaults to
# 1.05 (fans, a share of room cooling). Compute energy is reported separately
# from the PUE-inclusive total, so the overhead is always visible.
# BENCH_DATACENTER_PUE=1.2
# BENCH_LOCAL_PUE=1.05

# Amortized embodied (manufacturing) carbon per local run, in grams — Scope 3
# Cat. 2, capital goods. Default 0 means NOT COUNTED, which understates
# self-hosted inference and makes local models look better than they are. To
# count it: your hardware's embodied footprint / the runs you expect over its
# life (e.g. 300 kgCO2e workstation / 100k runs = 3 g).
# BENCH_EMBODIED_G_PER_RUN=0

# Model for the frontier-baseline counterfactual reported on each run and in
# GET /api/analytics/emissions. Empty auto-selects the highest-energy-class
# curated non-local model. The comparison re-prices the SAME token counts through
# that model: an efficiency indicator, never an offset, a credit, or a reduction
# claim, and it goes negative when a run is heavier than the baseline.
# BENCH_EMISSIONS_BASELINE_MODEL=anthropic/claude-fable-5

# ── local development (outside docker) ────────────────────────────────────────
# BENCH_DATABASE_URL=postgresql+asyncpg://bench:bench@localhost:5432/bench
# BENCH_STORAGE_DIR=./storage
# BENCH_PACKS_DIR=../packs
